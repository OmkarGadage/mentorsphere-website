Ass 1

#include <iostream>
#include <vector>
#include <queue>
using namespace std;

class Graph {
    int V;
    vector<vector<int>> adj;

public:
    Graph(int v) : V(v), adj(v) {}

    void addEdge(int u, int v) {
        adj[u].push_back(v);
        adj[v].push_back(u); // undirected graph
    }

    // DFS target search + loop detection
    bool dfs(int node, int target, vector<bool>& visited, int parent) {
        visited[node] = true;

        if (node == target)
            return true;

        for (int neigh : adj[node]) {
            if (!visited[neigh]) {
                if (dfs(neigh, target, visited, node))
                    return true;
            }
            else if (neigh != parent) {
                cout << "Loop detected at edge: " << node << " -> " << neigh << endl;
            }
        }
        return false;
    }

    // BFS target search + loop detection
    bool bfs(int start, int target) {
        vector<bool> visited(V, false);
        vector<int> parent(V, -1);
        queue<int> q;

        visited[start] = true;
        q.push(start);

        while (!q.empty()) {
            int node = q.front();
            q.pop();

            if (node == target)
                return true;

            for (int neigh : adj[node]) {
                if (!visited[neigh]) {
                    visited[neigh] = true;
                    parent[neigh] = node;
                    q.push(neigh);
                }
                else if (parent[node] != neigh) {
                    cout << "Loop detected at edge: " << node << " -> " << neigh << endl;
                }
            }
        }
        return false;
    }
};

int main() {
    int V, E;
    cout << "Enter number of vertices and edges: ";
    cin >> V >> E;

    Graph g(V);

    cout << "Enter edges (u v):\n";
    for (int i = 0; i < E; i++) {
        int u, v;
        cin >> u >> v;
        g.addEdge(u, v);
    }

    int start, target;
    cout << "Enter start node and target: ";
    cin >> start >> target;

    vector<bool> visited(V, false);

    cout << "\nDFS Result: ";
    cout << (g.dfs(start, target, visited, -1) ? "Target Found\n" : "Target Not Found\n");

    cout << "\nBFS Result: ";
    cout << (g.bfs(start, target) ? "Target Found\n" : "Target Not Found\n");

    return 0;
}

