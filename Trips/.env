Ass 6
def diagnose():
    print("=== Medical Expert System ===")
    
    fever = input("Do you have fever? (yes/no): ").lower()
    cough = input("Do you have cough? (yes/no): ").lower()
    sore_throat = input("Do you have sore throat? (yes/no): ").lower()
    headache = input("Do you have headache? (yes/no): ").lower()
    body_pain = input("Do you have body pain? (yes/no): ").lower()
    chest_pain = input("Do you have chest pain? (yes/no): ").lower()
    breath_short = input("Do you have shortness of breath? (yes/no): ").lower()
    stomach_pain = input("Do you have stomach pain? (yes/no): ").lower()
    vomiting = input("Do you have vomiting? (yes/no): ").lower()

    print("\n--- Diagnosis Result ---")

    if fever == "yes" and cough == "yes" and sore_throat == "yes":
        print("Possible Disease: Flu")
        print("Advice: Take rest, drink fluids, consult doctor if severe.")

    elif fever == "yes" and headache == "yes" and body_pain == "yes":
        print("Possible Disease: Viral Fever")
        print("Advice: Stay hydrated, take paracetamol, consult doctor.")

    elif chest_pain == "yes" and breath_short == "yes":
        print("Possible Disease: Heart Problem")
        print("Advice: Seek immediate medical attention!")

    elif stomach_pain == "yes" and vomiting == "yes":
        print("Possible Disease: Food Poisoning")
        print("Advice: Drink ORS, avoid solid food, consult doctor.")

    else:
        print("No clear diagnosis.")
        print("Advice: Please consult a doctor for proper diagnosis.")

# Run the system
diagnose()
