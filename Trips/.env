Ass 4

#include <bits/stdc++.h>
using namespace std;

// Global vectors to keep track of safe positions (Branch and Bound)
vector<int> col_safe;
vector<int> diag1_safe; // Normal diagonal (↘)
vector<int> diag2_safe; // Anti diagonal (↙)
vector<vector<int>> board;
int n;

// Function to print the board
void printBoard() {
    cout << "\nSolution for " << n << "-Queens:\n";
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            if (board[i][j]) cout << " Q ";
            else cout << " . ";
        }
        cout << "\n";
    }
}

// Recursive function to solve N-Queens
bool solveNQueens(int row) {
    // Base Case: If all queens are placed, return true
    if (row == n) {
        return true; 
    }

    // Try placing a queen in all columns one by one for the current row
    for (int col = 0; col < n; col++) {
        
        // Branch and Bound: Check constraints in O(1) time
        // diag1 formula: row - col + (n - 1)
        // diag2 formula: row + col
        if (!col_safe[col] && !diag1_safe[row - col + n - 1] && !diag2_safe[row + col]) {
            
            // 1. Place the queen
            board[row][col] = 1;
            
            // 2. Bound the branches: Mark the column and diagonals as unsafe
            col_safe[col] = 1;
            diag1_safe[row - col + n - 1] = 1;
            diag2_safe[row + col] = 1;

            // 3. Recurse to place the rest of the queens
            if (solveNQueens(row + 1)) {
                return true; // Stop searching once the first solution is found
            }

           -- // 4. Backtrack: If placing queen here doesn't lead to a solution, remove it
            board[row][col] = 0;
            col_safe[col] = 0;
            diag1_safe[row - col + n - 1] = 0;
            diag2_safe[row + col] = 0;
        }
    }
    
    // If no column is safe in this row, return false to trigger backtracking
    return false;
}

int main() {
    cout << "Enter the number of queens (n) [Max 39]: ";
    cin >> n;
    // Input validation
    if (n <= 0 || n > 39) {
        cout << "Invalid input! Please enter a number between 1 and 39." << endl;
        return 0;
    }
    if (n == 2 || n == 3) {
        cout << "No solution exists for " << n << "-Queens problem." << endl;
        return 0;
    }
    // Initialize the board and tracking arrays based on user input
    board.assign(n, vector<int>(n, 0));
    col_safe.assign(n, 0);
    diag1_safe.assign(2 * n, 0); 
    diag2_safe.assign(2 * n, 0); 

    // Start solving from row 0
    if (solveNQueens(0)) printBoard(); 
    else cout << "No solution exists." << endl;
    
    return 0;
}

