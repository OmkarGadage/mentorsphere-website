-- Chatbot.py 
from flask import Flask, request, jsonify
from flask_cors import CORS
import re
import random
from nltk.tokenize import word_tokenize
from nltk.corpus import stopwords
from nltk.stem import PorterStemmer
from textblob import TextBlob
import nltk
nltk.download('punkt')
nltk.download('punkt_tab')
nltk.download('stopwords')

app = Flask(__name__)
CORS(app)

class AdvancedCustomerBot:
    def __init__(self):
        self.context = {}
        self.stemmer = PorterStemmer()
        self.stop_words = set(stopwords.words('english'))

        self.intents = {
            'greeting': ['hello', 'hi', 'hey'],
            'goodbye': ['bye', 'goodbye', 'thanks'],
            'product': ['product', 'buy', 'purchase', 'shop'],
            'price': ['price', 'cost', 'how much'],
            'support': ['help', 'issue', 'problem'],
            'track': ['track', 'status', 'delivery'],
            'return': ['return', 'refund', 'cancel'],
            'complaint': ['bad', 'worst', 'angry']
        }

        self.responses = {
            'greeting': "Hey, welcome to ElectroShop. What do you want?",
            'product': "We sell laptops and phones. Try being specific.",
            'price': "Stuff ranges from ₹25k to ₹1.5L. Your wallet ready?",
            'support': "Explain your issue clearly. I'm not psychic.",
            'track': "Give me your order ID.",
            'return': "30-day return policy. Keep your receipt.",
            'goodbye': "Alright, go spend money somewhere.",
            'default': "That made zero sense. Try again.",
            'escalate': "You sound upset. Escalating to human support.\n Please contact "
        }

    def preprocess(self, text):
        tokens = word_tokenize(text.lower())
        return [self.stemmer.stem(w) for w in tokens if w.isalpha() and w not in self.stop_words]

    def detect_intent(self, tokens):
        scores = {}
        for intent, words in self.intents.items():
            scores[intent] = sum(1 for t in tokens if t in words)

        best = max(scores, key=scores.get)
        return best if scores[best] > 0 else 'default'

    def analyze_sentiment(self, text):
        polarity = TextBlob(text).sentiment.polarity
        if polarity < -0.3:
            return 'negative'
        elif polarity > 0.3:
            return 'positive'
        return 'neutral'

    def generate_response(self, text):
        tokens = self.preprocess(text)
        intent = self.detect_intent(tokens)
        sentiment = self.analyze_sentiment(text)

        if sentiment == 'negative':
            return self.responses['escalate']

        # Track order ID
        order_match = re.findall(r'\b\d{5,}\b', text)
        if order_match:
            self.context['order_id'] = order_match[0]
            return f"Order {order_match[0]} is on the way. Try being patient."

        return self.responses.get(intent, self.responses['default'])


bot = AdvancedCustomerBot()

@app.route("/chat", methods=["POST"])
def chat():
    user_msg = request.json.get("message")
    response = bot.generate_response(user_msg)
    return jsonify({"response": response})


if __name__ == "__main__":
    app.run(debug=True)

